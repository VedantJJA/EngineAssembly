# ==============================================================================
# Unity .gitignore Template (Optimized for EngineAssembly)
# ==============================================================================

# Unity generated caches and temporary directories
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log

# By default unity supports Blender asset imports; *.blend1 files do not need version control
*.blend1
*.blend1.meta

# JetBrains Rider personal-layer settings & plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio & VS Code cache
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Gradle cache directory
.gradle/

# Auto-generated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for debug/build artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt
mono_crash.*

# Builds and standalone packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers*

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Unconverted CAD parts and raw CAD assemblies
/[Aa]ssets/V8 Engine(unconverted)/
/[Aa]ssets/V8 Engine(unconverted).meta
*.SLDPRT
*.SLDPRT.meta
*.SLDASM
*.SLDASM.meta
*.step
*.stp
*.iges
*.igs
*.x_t
*.x_b
*.sat

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# Python tooling caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/
.cache/
**/.cache/

# Project-specific: Collider decomposition tools & Python dependencies
Tools/Colliders/python_deps/
Tools/Colliders/settings.local.json

# Project-specific: Narration AI models, local state & temp files
Tools/Narration/Models/
Tools/Narration/Voice/
Tools/Narration/*.pid
Tools/Narration/job-status.json
Tools/Narration/progress.json
Tools/Narration/audio-verification.json
Tools/Narration/unity-import-report.json
Tools/Narration/*-status.json

# Project-specific: Disposable Unity verification workspaces and build intermediates
Tools/Verification/bin/
Tools/Verification/*.rsp
Tools/Verification/*.log
Tools/Verification/*.apk
Tools/Verification/UnityProject/
Tools/Verification/ARBackup-*/
Tools/Verification/Before*/
Tools/Verification/Bee-*/
Tools/Verification/manifest-test/

# Project-specific: Verification test outputs, reports, and screen captures
Tools/Verification/*-report.json
Tools/Verification/*-status.json
Tools/Verification/*.png
Tools/Verification/*.ndjson
Tools/Verification/ar-ground-plane-*.json
Tools/Verification/ar-rebuild-*.json
Tools/Verification/ground-plane-*.json
Tools/Verification/guidance-pickup-*.json
Tools/Verification/vr-interaction-performance-*.json
Tools/Verification/quest-hands-package.json

# Backups: Kept locally for disaster recovery, excluded from Git
/[Bb]ackups/

# Deliverables and presentations: Review slide builds and export presentations
/[Dd]eliverables/

# Unity temporary scene recovery copies
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
